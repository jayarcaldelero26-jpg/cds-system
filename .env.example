APP_NAME="CDS-SMART"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production deployment requirements (set in the deployment secret/config store):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-production-hostname
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax
# TRUSTED_PROXIES=<exact reverse-proxy IPs/CIDRs; leave empty for direct local access>
# Configure production DB, mail, archive credentials, durable private storage,
# queue workers, cache, and scheduler for the actual deployment environment.
ENGP_IAC_GENERATOR_URL=

# Only set these for an explicitly authorized initial seed. Never commit the
# password or reuse it after the first administrator login.
EDATS_SEED_ADMIN_EMAIL=
EDATS_SEED_ADMIN_PASSWORD=

# Set TRUSTED_PROXIES to the exact reverse-proxy IPs/CIDRs used in production.
# Leave empty for direct local/Laragon HTTP access.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Compliance alerts are intentionally disabled until delivery recipients are approved.
COMPLIANCE_ALERTS_ENABLED=false
COMPLIANCE_TEST_EMAIL_ENABLED=false
COMPLIANCE_ALERTS_SEND_TIME=08:00
COMPLIANCE_ALERTS_TIMEZONE=Asia/Manila
